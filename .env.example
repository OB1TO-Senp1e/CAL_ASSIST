# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calassist?schema=public"

# Optional: direct (session) connection used by `prisma migrate` / `db pull`.
# Migrations must never run through a PgBouncer transaction pooler, so when a
# pooler DATABASE_URL is in use (e.g. Supabase with ?pgbouncer=true on port
# 6543) set DIRECT_URL to the session endpoint (same host, port 5432, no
# pgbouncer param). prisma.config.ts rejects any migration URL carrying
# `pgbouncer=true`. Local/Docker setups can omit this: DATABASE_URL is used.
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/calassist?schema=public"

# SAFETY RAIL: schema-touching Prisma commands (migrate/db push/db execute)
# against a NON-loopback database are REFUSED by prisma.config.ts unless this
# is explicitly set to 1. Leave unset in daily development; set it in the shell
# only for a deliberate, reviewed deploy to the live/remote database.
# ALLOW_LIVE_MIGRATE=1

# Database pool size: API replica count multiplied by this value contributes to
# PostgreSQL max_connections. See the README load-balancer section for budgeting.
DATABASE_POOL_MAX="10"
API_REPLICA_COUNT="2"
WORKER_POOL_CONNECTIONS="0"
POSTGRES_MAX_CONNECTIONS="100"
DATABASE_CONNECTION_HEADROOM="20"

# Redis (shared sessions, rate limits, and AI provider protections)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_CONNECT_TIMEOUT_MS="5000"
REDIS_MAXMEMORY="256mb"
REDIS_MEMORY_LIMIT="320m"
THROTTLE_TTL="60000"
THROTTLE_LIMIT="100"

# JWT
JWT_SECRET="your-secure-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="your-secure-oauth-session-secret-change-in-production"
SESSION_COOKIE_SECURE="false"
SESSION_COOKIE_SAME_SITE="lax"

# Load balancer (diagnostic response header is disabled by default)
TRAEFIK_HTTP_PORT="8080"
TRAEFIK_HTTPS_PORT="8443"
PUBLIC_HOST="localhost"
ACME_EMAIL=""
# Keep staging enabled for validation; use the production ACME URL only after
# PUBLIC_HOST resolves to this host and inbound ports 80/443 are reachable.
ACME_CA_SERVER="https://acme-staging-v02.api.letsencrypt.org/directory"
EXPOSE_INSTANCE_ID="false"
# Required only when enabling the optional Grafana monitoring profile.
GRAFANA_USER="admin"
GRAFANA_PASSWORD=""

# Security
BCRYPT_ROUNDS="12"

# Server
PORT="3000"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3001"
CORS_ALLOWED_ORIGINS="http://localhost:3001"

# AI Providers
AI_PROVIDER="openai" # or "ollama" or "nemotron"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"

# NVIDIA NIM (Nemotron)
NVIDIA_NIM_API_KEY="your-nvidia-nim-api-key"
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# Ollama (fallback/local AI)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_API_KEY=""
OLLAMA_MODEL="llama3.2:latest"

# Stage 5a: AI provider transport policy
# Wall-clock budget for ONE HTTP attempt to a provider (no retries included).
AI_REQUEST_TIMEOUT_MS="15000"
# Extra attempts after the first for a transient failure (429/5xx/timeout/network).
# Hard failures (400/401/403/404/422) are never retried regardless of this value.
AI_MAX_RETRIES="2"
AI_RETRY_BASE_DELAY_MS="250"
AI_RETRY_MAX_DELAY_MS="4000"

# Stage 5a: circuit breaker. Trips after N consecutive availability failures
# (timeout/network/5xx/429) and stays open for the cooldown. Auth failures (401/403)
# and unconfigured providers NEVER trip the breaker - a bad key is not an outage.
AI_CIRCUIT_ENABLED="true"
AI_CIRCUIT_FAILURE_THRESHOLD="3"
AI_CIRCUIT_COOLDOWN_MS="30000"
AI_CIRCUIT_SUCCESS_THRESHOLD="1"
AI_CIRCUIT_PROBE_LEASE_MS="60000"
AI_PROVIDER_MAX_CONCURRENCY="10"
AI_PROVIDER_CAPACITY_LEASE_MS="120000"
AI_PROVIDER_QUOTA_LIMIT="120"
AI_PROVIDER_QUOTA_WINDOW_MS="60000"

# Stage 5a: capability overrides. Blank/unset = use the built-in default for that
# provider. Set explicitly when a model on the endpoint differs from the default.
# Defaults: openai chat+tools+json+embed, nemotron chat+embed only,
#           ollama chat only.
AI_CAP_OPENAI_CHAT=""
AI_CAP_OPENAI_TOOL_CALLING=""
AI_CAP_OPENAI_STRUCTURED_OUTPUT=""
AI_CAP_OPENAI_EMBEDDINGS=""
AI_CAP_NEMOTRON_CHAT=""
AI_CAP_NEMOTRON_TOOL_CALLING=""
AI_CAP_NEMOTRON_STRUCTURED_OUTPUT=""
AI_CAP_NEMOTRON_EMBEDDINGS=""
AI_CAP_OLLAMA_CHAT=""
AI_CAP_OLLAMA_TOOL_CALLING=""
AI_CAP_OLLAMA_STRUCTURED_OUTPUT=""
AI_CAP_OLLAMA_EMBEDDINGS=""

# Stage 5a: live capability probing. Off by default: each probe leg is a real,
# billable request, and running it with mismatched credentials would produce 401s
# that must not be read as an outage. Enable deliberately, not casually.
AI_PROBE_ENABLED="false"

# Optional model overrides (fall back to the code defaults above when unset)
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
NVIDIA_NIM_EMBEDDING_MODEL="nvidia/nv-embedqa-e5-v5"
OLLAMA_EMBEDDING_MODEL=""

# Calendar Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# C9: In production every *_REDIRECT_URI / callback URL below MUST be set and
# MUST use https:// — the app fails fast at boot otherwise (see
# src/config/production-config.validator.ts). The localhost defaults below are
# for development only. Register the exact production values in Google Cloud
# Console → APIs & Services → Credentials → Authorized redirect URIs.
GOOGLE_LOGIN_CALLBACK_URL="http://localhost:8080/auth/google/callback"
GOOGLE_REDIRECT_URI="http://localhost:8080/api/calendar/callback/google"
MICROSOFT_REDIRECT_URI="http://localhost:8080/api/calendar/callback/outlook"
APPLE_REDIRECT_URI="http://localhost:8080/api/calendar/callback/apple"
# Base URL of the client (Vite dev server) the browser is redirected to after
# a calendar OAuth callback completes.
CLIENT_URL="http://localhost:5173"
# C8: Public HTTPS base URL this server is reachable at, used when registering
# Google Calendar push-notification watch channels (Google must POST back to
# it). Falls back to the internal server URL; set this when running behind a
# proxy/public host. Leave unset in local development (watch registration
# simply cannot be reached by Google then).
WEBHOOK_PUBLIC_URL=""
# C2: AES-256-GCM key used to encrypt stored OAuth tokens at rest.
# Must be a base64-encoded 32-byte key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production (the app fails fast without it). Also required to
# connect any calendar in any environment: without a key the app refuses to
# store tokens rather than writing them in plaintext.
OAUTH_TOKEN_KEY="your-base64-encoded-32-byte-key"
OAUTH_TOKEN_PREVIOUS_KEYS=""
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# Notifications
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
