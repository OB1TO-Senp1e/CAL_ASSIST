# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calassist?schema=public"

# JWT
JWT_SECRET="your-secure-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Security
BCRYPT_ROUNDS="12"

# Server
PORT="3000"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3001"

# AI Providers
AI_PROVIDER="openai" # or "ollama" or "nemotron"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"

# NVIDIA NIM (Nemotron)
NVIDIA_NIM_API_KEY="your-nvidia-nim-api-key"
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# Ollama (fallback/local AI)
OLLAMA_BASE_URL="http://localhost:11434"

# Calendar Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# Notifications
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
