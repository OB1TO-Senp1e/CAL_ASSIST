generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String?
  passwordHash             String
  timezone                 String                    @default("UTC")
  locale                   String                    @default("en-US")
  deletedAt                DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  aiSuggestions            AiSuggestion[]
  assistantActions         AssistantAction[]
  assistantRecommendations AssistantRecommendation[]
  auditLogs                AuditLog[]
  autonomyRules            AutonomyRule[]
  autonomyPolicies         AutonomyPolicy[]
  ruleConflicts            RuleConflict[]
  replanningPolicies       ReplanningPolicy[]
  availabilities           AvailabilityRule[]
  calendars                Calendar[]
  calendarConnections      CalendarConnection[]
  commitments              Commitment[]
  constraints              Constraint[]
  conversations            Conversation[]
  deadlines                Deadline[]
  events                   Event[]
  focusBlocks              FocusBlock[]
  goals                    Goal[]
  integrations             Integration[]
  intents                  Intent[]
  memories                 Memory[]
  memoryRelations          MemoryRelation[]
  memoryConflicts          MemoryConflict[]
  milestones               Milestone[]
  notifications            Notification[]
  permissions              Permission[]
  plans                    Plan[]
  planVersions             PlanVersion[]
  preferences              Preference[]
  profile                  Profile?
  projects                 Project[]
  reminders                Reminder[]
  routines                 Routine[]
  schedules                Schedule[]
  scheduleBlocks           ScheduleBlock[]
  scheduleChanges          ScheduleChange[]
  sessions                 Session[]
  tasks                    Task[]
  timeBlocks               TimeBlock[]
  travelBuffers            TravelBuffer[]
  scheduleProposalRecords  ScheduleProposalRecord[]
  deviationStates          DeviationState[]
  interventionStates       InterventionState[]
  meetingArtifacts         MeetingArtifact[]
  recommendationStates     RecommendationState[]
  meetings                 Meeting[]
  schedulingPreferences    SchedulingPreference[]
  aiActionLogs             AiActionLog[]

  @@index([email])
  @@index([deletedAt])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  avatarUrl    String?
  bio          String?
  organization String?
  jobTitle     String?
  phone        String?
  dateCreated  DateTime @default(now())
  lastUpdated  DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Preference {
  id          String             @id @default(cuid())
  userId      String
  category    PreferenceCategory
  key         String
  valueJson   String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  user        User               @relation(fields: [userId], references: [id])

  @@unique([userId, category, key])
  @@index([userId])
}

model Goal {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  status      GoalStatus  @default(PENDING)
  priority    Int         @default(0)
  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  deadlines   Deadline[]
  user        User        @relation(fields: [userId], references: [id])
  milestones  Milestone[]
  plans       Plan[]
  projects    Project[]
  tasks       Task[]

  @@index([userId])
  @@index([userId, status])
  @@index([targetDate])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  goalId      String?
  title       String
  description String?
  status      ProjectStatus @default(PENDING)
  priority    Int           @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  deadlines   Deadline[]
  milestones  Milestone[]
  goal        Goal?         @relation(fields: [goalId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  tasks       Task[]

  @@index([userId])
  @@index([goalId])
  @@index([dueDate])
}

model Milestone {
  id          String          @id @default(cuid())
  userId      String
  goalId      String?
  projectId   String?
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  priority    Int             @default(0)
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  goal        Goal?           @relation(fields: [goalId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  tasks       Task[]

  @@index([userId])
  @@index([goalId])
  @@index([projectId])
  @@index([dueDate])
}

model Task {
  id                   String           @id @default(cuid())
  userId               String
  projectId            String?
  goalId               String?
  milestoneId          String?
  intentId             String?
  title                String
  description          String?
  status               TaskStatus       @default(PENDING)
  priority             Int              @default(0)
  estimatedDurationMin Int?
  actualDurationMin    Int?
  dueDate              DateTime?
  startDate            DateTime?
  completedAt          DateTime?
  source               TaskSource       @default(USER)
  flexibility          TaskFlexibility  @default(MEDIUM)
  energyRequirement    EnergyLevel      @default(MEDIUM)
  context              String?
  preferredTime        DateTime?
  location             String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?
  parentTaskId         String?
  focusBlocks          FocusBlock[]
  reminders            Reminder[]
  goal                 Goal?            @relation(fields: [goalId], references: [id])
  intent               Intent?          @relation(fields: [intentId], references: [id])
  milestone            Milestone?       @relation(fields: [milestoneId], references: [id])
  parentTask           Task?            @relation("TaskParent", fields: [parentTaskId], references: [id])
  subtasks             Task[]           @relation("TaskParent")
  project              Project?         @relation(fields: [projectId], references: [id])
  user                 User             @relation(fields: [userId], references: [id])
  dependencies         TaskDependency[] @relation("TaskPrerequisites")
  dependentOf          TaskDependency[] @relation("TaskDependents")
  timeBlocks           TimeBlock[]

  @@index([userId])
  @@index([projectId])
  @@index([goalId])
  @@index([milestoneId])
  @@index([intentId])
  @@index([status])
  @@index([dueDate])
  @@index([parentTaskId])
  @@index([flexibility])
  @@index([energyRequirement])
}

model TaskDependency {
  id          String         @id @default(cuid())
  taskId      String
  dependsOnId String
  type        DependencyType @default(FINISH_TO_START)
  createdAt   DateTime       @default(now())
  dependsOn   Task           @relation("TaskPrerequisites", fields: [dependsOnId], references: [id])
  task        Task           @relation("TaskDependents", fields: [taskId], references: [id])

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
}

model Calendar {
  id           String              @id @default(cuid())
  userId       String
  connectionId String?
  name         String
  description  String?
  color        String?             @default("#3b82f6")
  timezone     String              @default("UTC")
  isVisible    Boolean             @default(true)
  isPrimary    Boolean             @default(false)
  provider     CalendarProvider    @default(LOCAL)
  externalId   String?
  syncToken    String?
  lastSynced   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  connection   CalendarConnection? @relation(fields: [connectionId], references: [id])
  user         User                @relation(fields: [userId], references: [id])
  events       Event[]

  @@unique([userId, connectionId, externalId])
  @@index([userId])
  @@index([connectionId])
  @@index([provider])
  @@index([externalId])
}

// C7: server-side PKCE store for the hand-rolled calendar OAuth flows.
// Keyed by SHA-256 of the signed state JWT (no bearer material in the DB).
// Holds the code_verifier for exactly one callback: consumed (deleted) on use
// and ignored once expiresAt has passed. The verifier never appears in any
// URL, the state JWT, or logs.
model CalendarOAuthPkce {
  id           String           @id
  codeVerifier String
  userId       String
  provider     CalendarProvider
  createdAt    DateTime         @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?

  @@index([expiresAt])
}

// C8: Google Calendar push-notification channels. Created at watch time; a
// notification is only trusted when its channel token + channel id + resource
// id all match a live row (Google does NOT sign push payloads with HMAC).
model CalendarPushChannel {
  id           String           @id @default(cuid())
  userId       String
  provider     CalendarProvider
  channelId    String
  resourceUri  String
  channelToken String
  expiration   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([provider, channelId])
  @@index([userId])
}

model CalendarConnection {
  id             String           @id @default(cuid())
  userId         String
  provider       CalendarProvider
  externalUserId String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String[]
  isActive       Boolean          @default(true)
  lastSync       DateTime?
  syncToken      String?
  syncError      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  calendars      Calendar[]
  user           User             @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model Event {
  id                 String             @id @default(cuid())
  userId             String
  calendarId         String?
  title              String
  description        String?
  location           String?
  startDate          DateTime
  endDate            DateTime
  allDay             Boolean            @default(false)
  timezone           String             @default("UTC")
  recurrenceRule     String?
  exceptionDates     DateTime[]
  originalEndDate    DateTime?
  status             EventStatus        @default(CONFIRMED)
  visibility         EventVisibility    @default(PRIVATE)
  source             EventSource        @default(USER)
  category           EventCategory      @default(PERSONAL)
  color              String?
  calendarExternalId String?
  externalETag       String?
  createdBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  calendar           Calendar?          @relation(fields: [calendarId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
  eventParticipants  EventParticipant[]
  reminders          Reminder[]
  timeBlocks         TimeBlock[]
  meeting            Meeting?

  @@index([userId])
  @@index([calendarId])
  @@index([startDate, endDate])
  @@index([recurrenceRule])
  @@index([calendarExternalId])
  @@index([category])
}

model EventParticipant {
  id             String            @id @default(cuid())
  eventId        String
  email          String
  displayName    String?
  status         ParticipantStatus @default(NEEDS_ACTION)
  isOrganizer    Boolean           @default(false)
  responseStatus String?
  createdAt      DateTime          @default(now())
  event          Event             @relation(fields: [eventId], references: [id])

  @@unique([eventId, email])
  @@index([eventId])
  @@index([email])
}

model Reminder {
  id           String              @id @default(cuid())
  userId       String
  eventId      String?
  taskId       String?
  commitmentId String?
  timeType     ReminderType
  timeValue    Int
  method       NotificationChannel @default(APP)
  message      String?
  isActive     Boolean             @default(true)
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  commitment   Commitment?         @relation(fields: [commitmentId], references: [id])
  event        Event?              @relation(fields: [eventId], references: [id])
  task         Task?               @relation(fields: [taskId], references: [id])
  user         User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([eventId])
  @@index([taskId])
  @@index([commitmentId])
}

model Commitment {
  id                String           @id @default(cuid())
  userId            String
  title             String
  description       String?
  deadline          DateTime
  timezone          String           @default("UTC")
  status            CommitmentStatus @default(PENDING)
  priority          Int              @default(0)
  source            CommitmentSource @default(USER)
  // Stage 4: meeting extraction already produces `person` / `personEmail` /
  // `confidence` / `context` (see the client's MeetingCommitment type), but the
  // model had nowhere to put them, so an extracted commitment could not survive
  // the write. `confidence` also makes the `LOW_CONFIDENCE` risk factor — which
  // was declared but unreachable — actually evaluable.
  person            String?
  personEmail       String?
  confidence        Float?
  context           String?
  // Links a commitment to the entity it was promised against, so the UI can
  // show "for <project>" and the risk engine can check for allocated time.
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  user              User             @relation(fields: [userId], references: [id])
  reminders         Reminder[]
  timeBlocks        TimeBlock[]      @relation("TimeBlockCommitment")
  relatedTimeBlocks TimeBlock[]      @relation("TimeBlockRelatedCommitment")

  @@index([userId])
  @@index([deadline])
  @@index([status])
  @@index([person])
  @@index([confidence])
}

model Routine {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  dayOfWeek   Int
  startTime   String
  endTime     String
  timezone    String      @default("UTC")
  isActive    Boolean     @default(true)
  priority    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])
  timeBlocks  TimeBlock[]

  @@index([userId])
  @@index([dayOfWeek])
  @@index([isActive])
}

model TimeBlock {
  id                  String          @id @default(cuid())
  userId              String
  eventId             String?
  taskId              String?
  focusBlockId        String?
  travelBufferId      String?
  routineId           String?
  scheduleId          String?
  title               String
  description         String?
  startDate           DateTime
  endDate             DateTime
  timezone            String          @default("UTC")
  blockType           TimeBlockType
  status              TimeBlockStatus @default(SCHEDULED)
  focusLevel          Int?            @default(1)
  source              TimeBlockSource @default(USER)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  commitmentId        String?
  relatedCommitmentId String?
  commitment          Commitment?     @relation("TimeBlockCommitment", fields: [commitmentId], references: [id])
  event               Event?          @relation(fields: [eventId], references: [id])
  focusBlock          FocusBlock?     @relation(fields: [focusBlockId], references: [id])
  relatedCommitment   Commitment?     @relation("TimeBlockRelatedCommitment", fields: [relatedCommitmentId], references: [id])
  routine             Routine?        @relation(fields: [routineId], references: [id])
  schedule            Schedule?       @relation(fields: [scheduleId], references: [id])
  task                Task?           @relation(fields: [taskId], references: [id])
  travelBuffer        TravelBuffer?   @relation(fields: [travelBufferId], references: [id])
  user                User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([startDate, endDate])
  @@index([eventId])
  @@index([taskId])
  @@index([blockType])
  @@index([scheduleId])
}

model FocusBlock {
  id              String      @id @default(cuid())
  userId          String
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime
  timezone        String      @default("UTC")
  focusLevel      Int         @default(3)
  taskId          String?
  scheduledTaskId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  task            Task?       @relation(fields: [taskId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  timeBlocks      TimeBlock[]

  @@index([userId])
  @@index([startDate, endDate])
  @@index([taskId])
}

model TravelBuffer {
  id           String      @id @default(cuid())
  userId       String
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime
  timezone     String      @default("UTC")
  fromLocation String?
  toLocation   String?
  travelMode   TravelMode  @default(DRIVING)
  durationMin  Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  timeBlocks   TimeBlock[]
  user         User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([startDate, endDate])
}

model AvailabilityRule {
  id          String             @id @default(cuid())
  userId      String
  title       String?
  dayOfWeek   Int?
  startDate   DateTime?
  endDate     DateTime?
  startTime   String
  endTime     String
  timezone    String             @default("UTC")
  recurrence  RecurrencePattern? @default(WEEKLY)
  isAvailable Boolean            @default(true)
  priority    Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  user        User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([dayOfWeek])
  @@index([startDate, endDate])
}

model Constraint {
  id              String             @id @default(cuid())
  userId          String
  title           String
  description     String?
  type            ConstraintType
  severity        ConstraintSeverity @default(MEDIUM)
  startDate       DateTime?
  endDate         DateTime?
  timeWindowStart String?
  timeWindowEnd   String?
  daysOfWeek      Int[]
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  user            User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([isActive])
}

model Deadline {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  dueDate     DateTime
  timezone    String         @default("UTC")
  goalId      String?
  projectId   String?
  status      DeadlineStatus @default(PENDING)
  priority    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  goal        Goal?          @relation(fields: [goalId], references: [id])
  project     Project?       @relation(fields: [projectId], references: [id])
  user        User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([goalId])
  @@index([projectId])
  @@index([dueDate])
  @@index([status])
}

model Memory {
  id              String            @id @default(cuid())
  userId          String
  content         String
  description     String?
  category        MemoryCategory
  scope           MemoryScope       @default(GLOBAL)
  importance      Float             @default(0.5)
  confidence      Float?
  embedding       Float[]           @default([])
  source          MemorySource      @default(USER_INPUT)
  status          MemoryStatus      @default(ACTIVE)
  isUserEditable  Boolean           @default(true)
  isConfirmed     Boolean           @default(false)
  confirmedAt     DateTime?
  confirmedBy     String?
  tags            String[]          @default([])
  metadata        Json?
  accessCount     Int               @default(0)
  lastAccessed    DateTime          @default(now())
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id])
  sourceRelations MemoryRelation[]  @relation("SourceMemory")
  targetRelations MemoryRelation[]  @relation("TargetMemory")
  conflicts1      MemoryConflict[]  @relation("MemoryConflict1")
  conflicts2      MemoryConflict[]  @relation("MemoryConflict2")

  @@index([userId])
  @@index([category])
  @@index([source])
  @@index([importance])
  @@index([expiresAt])
  @@index([status])
  @@index([scope])
  @@index([isConfirmed])
}

model MemoryConflict {
  id            String        @id @default(cuid())
  userId        String
  memoryId1     String
  memoryId2     String
  type          String
  description   String
  severity      String
  detectedAt    DateTime      @default(now())
  resolvedAt    DateTime?
  resolution    String?
  memory1       Memory        @relation("MemoryConflict1", fields: [memoryId1], references: [id], onDelete: Cascade)
  memory2       Memory        @relation("MemoryConflict2", fields: [memoryId2], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([memoryId1])
  @@index([memoryId2])
  @@index([resolvedAt])
}

model MemoryRelation {
  id              String   @id @default(cuid())
  userId          String
  memoryId        String
  relatedMemoryId String
  relationType    String
  strength        Float    @default(0.5)
  createdAt       DateTime @default(now())
  memory          Memory   @relation("SourceMemory", fields: [memoryId], references: [id])
  relatedMemory   Memory   @relation("TargetMemory", fields: [relatedMemoryId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([memoryId])
  @@index([relatedMemoryId])
}

model Conversation {
  id              String                    @id @default(cuid())
  userId          String
  title           String?
  context         Json?
  model           String?
  provider        String?
  isActive        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  lastMessageAt   DateTime                  @default(now())
  actions         AssistantAction[]
  recommendations AssistantRecommendation[]
  user            User                      @relation(fields: [userId], references: [id])
  messages        ConversationMessage[]

  @@index([userId])
  @@index([isActive])
  @@index([lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  role           MessageRole
  content        String
  reasoning      String?
  tokensUsed     Int?
  modelOutput    Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([role])
}

model AssistantAction {
  id             String        @id @default(cuid())
  userId         String
  conversationId String?
  actionType     String
  entityType     String?
  entityId       String?
  parameters     Json?
  outcome        Json?
  confidence     Float?
  reasoning      String?
  wasApplied     Boolean       @default(false)
  appliedAt      DateTime?
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([conversationId])
  @@index([entityType, entityId])
}

model AssistantRecommendation {
  id             String               @id @default(cuid())
  userId         String
  conversationId String?
  type           RecommendationType
  title          String
  description    String
  reasoning      String
  confidence     Float
  priority       Int                  @default(0)
  entityType     String?
  entityId       String?
  context        Json?
  expiresAt      DateTime?
  status         RecommendationStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  conversation   Conversation?        @relation(fields: [conversationId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([conversationId])
  @@index([status])
  @@index([expiresAt])
  @@index([type])
}

model AiSuggestion {
  id             String             @id @default(cuid())
  userId         String
  entityType     String
  entityId       String?
  intentId       String?
  title          String
  description    String
  reasoning      String
  confidence     Float
  suggestionJson String
  status         AiSuggestionStatus @default(PENDING)
  appliedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([status])
}

model Intent {
  id           String       @id @default(cuid())
  userId       String
  originalText String
  parsedJson   String
  confidence   Float?
  status       IntentStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id])
  tasks        Task[]

  @@index([userId])
  @@index([status])
}

model Plan {
  id          String        @id @default(cuid())
  userId      String
  title       String
  description String?
  goalId      String?
  status      PlanStatus    @default(DRAFT)
