/// Stage 4k: structured permission grants. Before 4k the service stored the
/// whole grant (action/scope/decision/conditions) as URL-encoded JSON smuggled
/// through the `scope` string with a `calassist.permission:` prefix; every
/// field is now a real, typed column.
model Permission {
  id         String             @id @default(cuid())
  userId     String
  action     PermissionAction
  scope      PermissionScope
  decision   PermissionDecision
  conditions Json               @default("{}")
  grantedBy  String             @default("USER")
  grantedAt  DateTime           @default(now())
  expiresAt  DateTime?
  isActive   Boolean            @default(true)
  user       User               @relation(fields: [userId], references: [id])

  @@unique([userId, action, scope])
  @@index([userId, scope])
  @@index([action])
  @@index([expiresAt])
}

/// Stage 4k: autonomy policies used to be JSON.stringify-ed into
/// AutonomyRule.actionConfig under a `calassistPolicy` key, which forced the
/// rules engine and the replanning engine to guess row types with marker
/// heuristics. Policies now live here and AutonomyRule is rule storage only.
model AutonomyPolicy {
  id                     String             @id @default(cuid())
  userId                 String
  name                   String
  description            String?
  autonomyLevel          AutonomyLevel      @default(SUGGEST)
  enabledScopes          PermissionScope[]
  allowedActions         PermissionAction[]
  riskThreshold          RiskLevel          @default(LOW)
  requireConfirmationFor PermissionAction[]
  protectedEntities      Json               @default("[]")
  timeRestrictions       Json               @default("[]")
  maxActionsPerPeriod    Json?
  isActive               Boolean            @default(true)
  priority               Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isActive])
}

/// Stage 4k: detected rule conflicts and their resolutions were recomputed on
/// every read and smuggled back as stringified entries in the owning rule's
/// `conditions.resolvedConflicts` JSON array. Conflicts are persisted here now,
/// keyed by the stable `<ruleId1>:<ruleId2>` external id the API already uses.
model RuleConflict {
  id                  String                 @id @default(cuid())
  userId              String
  /// External id: the two rule ids, sorted, joined by ':' (stable, parseable).
  conflictKey         String
  ruleId1             String
  ruleId2             String
  rule1Name           String
  rule2Name           String
  conflictType        RuleConflictType
  description         String
  severity            RuleConflictSeverity
  suggestedResolution RuleConflictResolution?
  detectedAt          DateTime               @default(now())
  resolvedAt          DateTime?
  resolution          RuleConflictResolution?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation(fields: [userId], references: [id])

  @@unique([userId, conflictKey])
  @@index([userId])
  @@index([resolvedAt])
}

model AutonomyRule {
  id           String              @id @default(cuid())
